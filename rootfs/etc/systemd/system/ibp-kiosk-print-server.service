# IBP station, feature package-printer: ibp-print-server from ibp-printing's
# `deploy` branch. The IBP frontend (the IBP Requests tile) posts each
# request label to http://localhost:40121/print-image and this prints it on
# the DYMO LabelWriter, directly over USB (/dev/usb/lpN, group lp). Adapted
# from ibp-printing
# packaging/linux/ibp-print-server.service (as on ibp-label-printer).
#
# Differences from that unit:
# - Runs as the system user ibp-kiosk-print (created by setup.d), whose home
#   /var/lib/ibp-kiosk-print holds the uv tool and the logs
#   (.local/state/ibp-printing/logs), not as the admin user.
# - The upgrade from GitHub is its own unit, ibp-kiosk-print-server-update,
#   so that this one can be limited to localhost: the server listens on every
#   interface, and only this machine's browser should reach it.
# - No resume unit: the stations shut down on lid close, never suspend.
[Unit]
Description=IBP label print server (localhost:40121)
Wants=network-online.target ibp-kiosk-print-server-update.service
After=network-online.target ibp-kiosk-print-server-update.service

[Service]
Type=simple
User=ibp-kiosk-print
# Opens the printer's usblp node (root:lp 0660).
SupplementaryGroups=lp
ExecStart=/usr/local/bin/ibp-kiosk-tool --no-upgrade ibp-printing-server ibp-print-server server
Restart=on-failure
RestartSec=5
# Only loopback traffic: the browser on this machine.
IPAddressDeny=any
IPAddressAllow=localhost
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full

[Install]
WantedBy=multi-user.target
