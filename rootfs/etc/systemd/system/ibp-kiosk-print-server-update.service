# IBP station, feature package-printer: before each start of
# ibp-kiosk-print-server (which wants this unit), upgrade ibp-printing from
# its `deploy` branch, so a reboot picks up a release. If the upgrade fails
# (no network), the server still starts on the installed version.
[Unit]
Description=Update the IBP label print server from GitHub
Wants=network-online.target
After=network-online.target
Before=ibp-kiosk-print-server.service

[Service]
Type=oneshot
User=ibp-kiosk-print
ExecStart=/usr/local/bin/ibp-kiosk-tool --install-only ibp-printing-server
TimeoutStartSec=15min
NoNewPrivileges=yes
PrivateTmp=yes
