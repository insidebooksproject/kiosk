<?xml version="1.0"?>
<!--
  labwc config for the IBP station session (labwc 0.8.3, Debian 13).
  ibp-kiosk-session runs labwc with -C /etc/ibp-kiosk/labwc, so this is the
  only rc.xml it reads. See labwc-config(5) and labwc-actions(5).

  Because this file defines its own <keybind> and <mousebind> entries, labwc
  loads none of its default bindings (no Alt-Tab, Alt-F4, window menu, root
  menu or desktop switching). Ctrl+Alt+F1..F12 still switch VTs: labwc
  handles those before any keybind.
-->
<labwc_config>

  <core>
    <decoration>server</decoration>
    <gap>0</gap>
  </core>

  <placement>
    <policy>center</policy>
  </placement>

  <desktops number="1">
    <popupTime>0</popupTime>
  </desktops>

  <snapping>
    <range>0</range>
  </snapping>

  <!-- Dialogs keep a title bar with only a close button: no minimize (a
       minimized window has no way back here) and no maximize. -->
  <!-- The theme holds only the close button's picture
       (/usr/share/themes/IBP-Kiosk/labwc); colours and sizes are in
       themerc-override here. -->
  <theme>
    <name>IBP-Kiosk</name>
    <titlebar>
      <layout>:close</layout>
    </titlebar>
    <cornerRadius>0</cornerRadius>
    <font place="ActiveWindow">
      <name>DejaVu Sans</name>
      <size>16</size>
      <weight>bold</weight>
    </font>
    <font place="InactiveWindow">
      <name>DejaVu Sans</name>
      <size>16</size>
      <weight>bold</weight>
    </font>
  </theme>

  <!-- The Home key: Super alone (pressed and released with no other key),
       or F12 for keyboards without one. It closes the current app and shows
       the tiles. -->
  <keyboard>
    <keybind key="Super_L" onRelease="yes">
      <action name="Execute" command="/usr/local/bin/ibp-kiosk-launcher home" />
    </keybind>
    <keybind key="Super_R" onRelease="yes">
      <action name="Execute" command="/usr/local/bin/ibp-kiosk-launcher home" />
    </keybind>
    <keybind key="F12" onRelease="yes">
      <action name="Execute" command="/usr/local/bin/ibp-kiosk-launcher home" />
    </keybind>
  </keyboard>

  <!-- Clicking focuses and raises a window; a dialog can be moved by its
       title bar, resized by its edges and closed. Nothing on the background. -->
  <mouse>
    <context name="Client">
      <mousebind button="Left" action="Press">
        <action name="Focus" />
        <action name="Raise" />
      </mousebind>
      <mousebind button="Right" action="Press">
        <action name="Focus" />
        <action name="Raise" />
      </mousebind>
      <mousebind button="Middle" action="Press">
        <action name="Focus" />
        <action name="Raise" />
      </mousebind>
    </context>
    <context name="TitleBar">
      <mousebind button="Left" action="Press">
        <action name="Focus" />
        <action name="Raise" />
      </mousebind>
    </context>
    <context name="Title">
      <mousebind button="Left" action="Drag">
        <action name="Move" />
      </mousebind>
    </context>
    <context name="Close">
      <mousebind button="Left" action="Click">
        <action name="Close" />
      </mousebind>
    </context>
    <context name="Top">
      <mousebind button="Left" action="Drag"><action name="Resize" /></mousebind>
    </context>
    <context name="Bottom">
      <mousebind button="Left" action="Drag"><action name="Resize" /></mousebind>
    </context>
    <context name="Left">
      <mousebind button="Left" action="Drag"><action name="Resize" /></mousebind>
    </context>
    <context name="Right">
      <mousebind button="Left" action="Drag"><action name="Resize" /></mousebind>
    </context>
    <context name="TLCorner">
      <mousebind button="Left" action="Drag"><action name="Resize" /></mousebind>
    </context>
    <context name="TRCorner">
      <mousebind button="Left" action="Drag"><action name="Resize" /></mousebind>
    </context>
    <context name="BLCorner">
      <mousebind button="Left" action="Drag"><action name="Resize" /></mousebind>
    </context>
    <context name="BRCorner">
      <mousebind button="Left" action="Drag"><action name="Resize" /></mousebind>
    </context>
  </mouse>

  <!-- Every main window opens maximized with no decorations. labwc gives a
       native Wayland window the type "dialog" when it has a parent or a fixed
       size (X11 windows use _NET_WM_WINDOW_TYPE), so dialogs, message boxes
       and other transient windows don't match and keep their title bar. -->
  <windowRules>
    <windowRule type="normal" serverDecoration="no">
      <action name="Maximize" />
    </windowRule>
    <!-- The terminal tiles (ibp-kiosk-app runs foot with these app ids) and
         Ship Manual (shippy-gui's app id) keep a title bar: it names the
         mode ("Ship Bulk") for as long as the app is open, and its close
         button returns to the tiles. A later rule wins over the one above.
         Colours are in themerc-override. -->
    <windowRule identifier="ibp-kiosk-ship-*" serverDecoration="yes" />
    <windowRule identifier="shippy-gui" serverDecoration="yes" />
    <windowRule identifier="ibp-kiosk-wifi" serverDecoration="yes" />
    <windowRule identifier="ibp-kiosk-print-diag" serverDecoration="yes" />
  </windowRules>

</labwc_config>
