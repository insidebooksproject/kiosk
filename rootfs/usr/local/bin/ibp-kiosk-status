#!/bin/sh
# ibp-kiosk-status CHECK: one status check for the launcher's status strip.
# Exit 0 = fine, 1 = problem, 2 = usage error. The first line of stdout is a
# short text for a volunteer. The launcher shows it as a tooltip, after the check's
# label ("IBP server: Not reachable"), so it doesn't repeat the label. Every external call has a timeout, so a check
# finishes in well under 10 s and never hangs.
#
#   network           Wi-Fi or cable connection (NetworkManager)
#   server            the IBP server answers GET /api/health
#   printer-shipping  a PM-2411-BT shipping label printer is plugged in and
#                     usable (from sysfs only: the printer allows one open at a
#                     time and shippy may be printing, so it is never opened)
#   printer-package   the print server on localhost:40121 sees a label printer
#   printers          both printer checks as one: fine when a printer is ready
#                     and neither check found a problem (the launcher's strip
#                     shows this one; the two above are for diagnosis)
#   update            what ibp-kiosk-update last did (its status file)
#   battery           the charge and, on battery, about how long it will last
#                     (from sysfs); prints nothing on a machine with no battery
#
# For testing: IBP_SERVER_URL, IBP_KIOSK_PRINT_SERVER_URL, IBP_KIOSK_SYS and
# IBP_KIOSK_DEV override the server, print server, /sys and /dev.
set -u

CONF_DIR=${IBP_KIOSK_CONF_DIR:-/etc/ibp-kiosk}
# The IBP server. /etc/ibp-kiosk/apps.conf (optional, shell syntax) may set
# IBP_SERVER_URL; the environment wins over both.
env_server_url=${IBP_SERVER_URL:-}
IBP_SERVER_URL=http://192.168.1.156
if [ -r "$CONF_DIR/apps.conf" ]; then
    # shellcheck source=/dev/null
    . "$CONF_DIR/apps.conf"
fi
IBP_SERVER_URL=${env_server_url:-$IBP_SERVER_URL}
PRINT_SERVER_URL=${IBP_KIOSK_PRINT_SERVER_URL:-http://localhost:40121}
SYS=${IBP_KIOSK_SYS:-/sys}
DEV=${IBP_KIOSK_DEV:-/dev}

# PM-2411-BT: model in its IEEE 1284 device ID, or its USB ids (the vendor id
# alone is shared by other devices). See ibp-printing docs/printers/pm2411bt.md.
PM2411BT_MODEL=PM2411BT
PM2411BT_VID=2e3c
PM2411BT_PID=5760

say() {
    printf '%s\n' "$1"
    exit "$2"
}

# nmcli -t escapes ":" and "\" in values with a backslash.
nm_unescape() {
    sed -e 's/\\:/:/g' -e 's/\\\\/\\/g'
}

check_network() {
    command -v nmcli >/dev/null 2>&1 || say "Can't check" 1
    devices=$(timeout 2 nmcli -t -f TYPE,STATE device 2>/dev/null) ||
        say "Can't check" 1
    wifi=no wired=no
    printf '%s\n' "$devices" | grep -qx 'wifi:connected' && wifi=yes
    printf '%s\n' "$devices" | grep -qx 'ethernet:connected' && wired=yes
    if [ "$wifi" = yes ]; then
        ssid=$(timeout 2 nmcli -t -f ACTIVE,SSID device wifi list --rescan no 2>/dev/null |
            sed -n 's/^yes://p' | head -n 1 | nm_unescape)
        what="Wi-Fi${ssid:+ $ssid}"
    elif [ "$wired" = yes ]; then
        what="Cable"
    else
        say "Not connected" 1
    fi
    # "unknown" (no connectivity check configured) counts as fine.
    case $(timeout 2 nmcli networking connectivity 2>/dev/null) in
    none | limited | portal) say "$what, but no internet" 1 ;;
    esac
    say "$what" 0
}

check_server() {
    reply=$(curl -s --connect-timeout 3 -m 4 -w '\n%{http_code}' \
        "$IBP_SERVER_URL/api/health" 2>/dev/null)
    code=$(printf '%s\n' "$reply" | tail -n 1)
    case $code in
    200)
        if printf '%s\n' "$reply" | grep -q '"status": *"ok"'; then
            say "OK" 0
        fi
        say "Not working right" 1
        ;;
    503) say "Database problem" 1 ;;
    000 | '') say "Not reachable" 1 ;;
    *) say "Error ($code)" 1 ;;
    esac
}

# The 1284 model (MDL: or MODEL:) of a usblp device, from sysfs.
ieee1284_model() {
    tr ';' '\n' <"$1/device/ieee1284_id" 2>/dev/null | awk -F: '
        { key = toupper($1); gsub(/^[ \t]+|[ \t]+$/, "", key) }
        key == "MDL" || key == "MODEL" {
            sub(/^[^:]*:[ \t]*/, ""); sub(/[ \t]+$/, ""); print; exit
        }'
}

# Names the volunteers use for the two printers, by serial number.
printer_name() {
    case $1 in
    Q529E5299340263) echo " (BOB)" ;;
    Q529E65K5250028) echo " (BETTY)" ;;
    esac
}

check_printer_shipping() {
    found=no problem=
    for entry in "$SYS"/class/usbmisc/lp*; do
        [ -e "$entry" ] || continue
        usb=$(cd -P "$entry/device/.." 2>/dev/null && pwd) || usb=
        vid=$(cat "$usb/idVendor" 2>/dev/null)
        pid=$(cat "$usb/idProduct" 2>/dev/null)
        model=$(ieee1284_model "$entry")
        model_uc=$(printf '%s' "$model" | tr '[:lower:]' '[:upper:]')
        if [ "$model_uc" != "$PM2411BT_MODEL" ] &&
            [ "$vid:$pid" != "$PM2411BT_VID:$PM2411BT_PID" ]; then
            continue
        fi
        found=yes
        node=$DEV/usb/${entry##*/}
        if [ ! -e "$node" ]; then
            problem="Not ready (no device file)"
        elif [ ! -r "$node" ] || [ ! -w "$node" ]; then
            problem="Plugged in, but not allowed (udev rule missing?)"
        else
            serial=$(cat "$usb/serial" 2>/dev/null)
            say "Ready$(printer_name "$serial")" 0
        fi
    done
    [ "$found" = yes ] && say "$problem" 1
    # Plugged in, but not bound to usblp (no /dev/usb/lpN).
    for usb in "$SYS"/bus/usb/devices/*; do
        [ "$(cat "$usb/idVendor" 2>/dev/null)" = "$PM2411BT_VID" ] || continue
        [ "$(cat "$usb/idProduct" 2>/dev/null)" = "$PM2411BT_PID" ] || continue
        say "Plugged in, but not detected (try replugging it)" 1
    done
    say "Not plugged in" 1
}

check_printer_package() {
    reply=$(curl -s --connect-timeout 2 -m 4 "$PRINT_SERVER_URL/health" 2>/dev/null) ||
        say "Print server not running" 1
    count=$(printf '%s\n' "$reply" | tr -d '\n' |
        sed -n 's/.*"count": *\([0-9][0-9]*\).*/\1/p')
    if ! printf '%s\n' "$reply" | grep -q '"status": *"ok"'; then
        say "Problem (see the print server log)" 1
    fi
    case $count in
    '') say "Print server not working right" 1 ;;
    0) say "Not plugged in" 1 ;;
    *) say "Ready" 0 ;;
    esac
}

# Both printers as one chip. "Not plugged in" from one check is not a
# problem while the other printer is ready; any other failure is.
check_printers() {
    ship=$(check_printer_shipping) && ship_ok=yes || ship_ok=no
    pkg=$(check_printer_package) && pkg_ok=yes || pkg_ok=no
    if [ "$ship_ok" = no ] && [ "$ship" != "Not plugged in" ]; then
        say "Shipping printer: $ship" 1
    fi
    if [ "$pkg_ok" = no ] && [ "$pkg" != "Not plugged in" ]; then
        say "Package printer: $pkg" 1
    fi
    # "Ready (BOB)" reads "Shipping printer ready (BOB)".
    ship=$(printf '%s' "$ship" | sed 's/^Ready/ready/')
    pkg=$(printf '%s' "$pkg" | sed 's/^Ready/ready/')
    if [ "$ship_ok" = yes ] && [ "$pkg_ok" = yes ]; then
        say "Shipping printer $ship, package printer $pkg" 0
    fi
    [ "$ship_ok" = yes ] && say "Shipping printer $ship" 0
    [ "$pkg_ok" = yes ] && say "Package printer $pkg" 0
    say "Not plugged in" 1
}

check_update() {
    file=${IBP_KIOSK_UPDATE_STATE:-/var/lib/ibp-kiosk/update}/status
    [ -r "$file" ] || say "Not checked yet" 0
    read -r state text <"$file" || say "Not checked yet" 0
    case $state in
    failed) say "${text:-Update failed}" 1 ;;
    *) say "${text:-OK}" 0 ;;
    esac
}

# A whole number from a sysfs file, without its sign; nothing if the file is
# missing or holds anything else.
sys_number() {
    sed -n '1s/^-\{0,1\}\([0-9][0-9]*\)$/\1/p' "$1" 2>/dev/null
}

# "about 2½ hours" for a number of minutes, rounded to what an estimate is
# good for: half hours from an hour up, 10 minutes below that (the caller
# never asks about less than 15).
about_minutes() {
    if [ "$1" -ge 53 ]; then
        halves=$((($1 + 15) / 30))
        hours=$((halves / 2))
        if [ $((halves % 2)) -eq 1 ]; then
            echo "about $hours½ hours"
        elif [ "$hours" -eq 1 ]; then
            echo "about 1 hour"
        else
            echo "about $hours hours"
        fi
    else
        echo "about $((($1 + 5) / 10 * 10)) minutes"
    fi
}

# At or below this charge, or with under 15 minutes left, the chip turns red
# on battery.
BATTERY_LOW=20

check_battery() {
    bat=
    for dir in "$SYS"/class/power_supply/*; do
        [ "$(cat "$dir/type" 2>/dev/null)" = Battery ] || continue
        [ "$(cat "$dir/present" 2>/dev/null)" = 0 ] && continue
        # scope "Device" is the battery of a wireless mouse or keyboard.
        [ "$(cat "$dir/scope" 2>/dev/null)" = Device ] && continue
        bat=$dir
        break
    done
    # No battery: fine, and nothing to say (the launcher hides the chip).
    [ -n "$bat" ] || exit 0

    # Batteries count in charge (µAh, with current in µA) or in energy
    # (µWh, with power in µW).
    now=$(sys_number "$bat/charge_now") full=$(sys_number "$bat/charge_full")
    rate=$(sys_number "$bat/current_avg")
    [ "${rate:-0}" -gt 0 ] || rate=$(sys_number "$bat/current_now")
    if [ -z "$now" ]; then
        now=$(sys_number "$bat/energy_now") full=$(sys_number "$bat/energy_full")
        rate=$(sys_number "$bat/power_now")
    fi
    percent=$(sys_number "$bat/capacity")
    if [ -z "$percent" ] && [ -n "$now" ] && [ "${full:-0}" -gt 0 ]; then
        percent=$((now * 100 / full))
    fi
    [ -n "$percent" ] || say "Can't be read" 1
    [ "$percent" -gt 100 ] && percent=100

    case $(cat "$bat/status" 2>/dev/null) in
    Discharging) ;;
    Charging) say "Charging ($percent%)" 0 ;;
    *) say "Plugged in ($percent%)" 0 ;;
    esac
    # No estimate without a reading, or from one too small to trust (just
    # after the charger is unplugged the average current is still near zero).
    minutes=
    if [ -n "$now" ] && [ "${rate:-0}" -gt 0 ]; then
        minutes=$((now * 60 / rate))
        [ "$minutes" -le 720 ] || minutes=
    fi
    if [ "$percent" -le "$BATTERY_LOW" ] || [ "${minutes:-99}" -lt 15 ]; then
        say "$percent%, plug in the charger" 1
    fi
    [ -n "$minutes" ] && say "$percent%, $(about_minutes "$minutes") left" 0
    say "$percent%, not plugged in" 0
}

case ${1:-} in
network) check_network ;;
server) check_server ;;
printer-shipping) check_printer_shipping ;;
printer-package) check_printer_package ;;
printers) check_printers ;;
update) check_update ;;
battery) check_battery ;;
*)
    echo "usage: ibp-kiosk-status network|server|printer-shipping|printer-package|printers|update|battery" >&2
    exit 2
    ;;
esac
