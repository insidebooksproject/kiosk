#!/bin/sh
# Run the launcher (launcher/ibp_kiosk in the repo) with the system python3
# and Debian's PySide6. "ibp-kiosk-launcher home" tells the running launcher
# to close the current app and show the tiles.
PYTHONPATH=/usr/local/lib/ibp-kiosk${PYTHONPATH:+:$PYTHONPATH}
export PYTHONPATH
exec python3 -m ibp_kiosk "$@"
